# HTTP port for FileHub (default 3001)
PORT=3001

# The ONLY directory users can browse and modify
FILEHUB_SHARE_DIR=/mnt/pendrive/FileHub/Compartilhados

# Private account/session-support files (not exposed by the web server)
FILEHUB_DATA_DIR=/root/.filehub-data

# Per-file upload limit in bytes (default 20 GiB)
MAX_FILE_SIZE=21474836480
MAX_FILES=300
